# Copia este archivo como .env y completa los valores.
PORT=4000

# Direcciones del frontend que pueden usar la API (separadas por comas).
CLIENT_ORIGIN=http://localhost:5173

# Clave larga y secreta para firmar los tokens JWT.
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Base de datos.
# Opcion A (Aiven): pega la "Service URI" que muestra Aiven.
DATABASE_URL=
# Certificado CA de Aiven (contenido del archivo ca.pem). Puedes pegarlo en una linea usando \n.
DB_SSL_CA=
# Opcion B (XAMPP en tu PC): deja DATABASE_URL vacia y usa estos datos.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=orbezu

# Google: el mismo Client ID que usa el frontend.
GOOGLE_CLIENT_ID=

# Correos con Resend (opcional). Sin clave, los correos se muestran en la consola.
RESEND_API_KEY=
EMAIL_FROM=Orbezu <onboarding@resend.dev>
APP_URL=http://localhost:5173

# Recordatorios de repaso (node-cron). Por defecto todos los dias a las 9:00 de Lima.
REMINDER_CRON=0 9 * * *
REMINDER_TZ=America/Lima
# Clave para lanzar los recordatorios desde fuera (por ejemplo GitHub Actions).
CRON_SECRET=
